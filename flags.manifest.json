      "key": "new-checkout",
      "name": "New checkout flow, rolled out to everyone in May 2026",
      "posthog": {
        "active": true,
        "archived": false,
        "deleted": false,
        "rollout": 100,
        "firstCalledDaysAgo": 120,
        "lastCalledDaysAgo": 1
      },
      "code": {
        "refs": [
          "src/app/dashboard/page.tsx"
        ],
        "pattern": "useFeatureFlagEnabled, both branches rendered"
      },
      "expected": {
        "verdict": "stale",
        "reason": "fully-rolled-out"
      }
    },
